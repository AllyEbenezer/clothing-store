<h1 class="text-2xl font-bold mb-6">Checkout</h1>

<div class="bg-white rounded-lg shadow-md p-6 mb-6">
  <h2 class="text-lg font-semibold mb-4">Order Summary</h2>
  <ul class="divide-y">
    <% @cart.line_items.each do |item| %>
      <li class="py-3 flex justify-between">
        <span><%= item.product.name %> × <%= item.quantity %></span>
        <span>$<%= item.subtotal %></span>
      </li>
    <% end %>
  </ul>
  <div class="mt-4 text-xl font-bold">
    Total: $<%= @cart.total_price %>
  </div>
</div>

<%= form_with model: @order, local: true do |f| %>
  <div class="space-y-4">
    <div>
      <%= f.label :shipping_address, class: "block font-medium" %>
      <%= f.text_area :shipping_address, rows: 3, class: "w-full border rounded-lg px-3 py-2", required: true %>
    </div>

    <div>
      <%= f.label :billing_address, class: "block font-medium" %>
      <%= f.text_area :billing_address, rows: 3, class: "w-full border rounded-lg px-3 py-2", required: true %>
    </div>

    <%= f.submit "Place Order", class: "bg-green-500 text-white px-6 py-3 rounded-lg font-medium hover:bg-green-600 w-full" %>
  </div>
<% end %>

<%= link_to "← Back to Cart", cart_path, class: "text-blue-500 hover:underline mt-4 inline-block" %>
