<div class="max-w-6xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-8 text-center">Our Products</h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
    <% @products.each do |product| %>
      <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
        <div class="p-4">
          <h2 class="text-xl font-semibold text-gray-800"><%= product.name %></h2>
          <p class="text-2xl font-bold text-green-600 mt-2">$<%= product.price %></p>
          <p class="text-gray-600 mt-2 text-sm"><%= product.description %></p>

          <div class="mt-4 flex gap-2">
            <%= link_to "View Details", product_path(product), class: "bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 text-sm" %>
            <%= button_to "Add to Cart", add_cart_path(product_id: product.id), method: :post, class: "bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 text-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>


